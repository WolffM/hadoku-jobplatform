{
	"name": "@wolffm/jobplatform-worker",
	"version": "2.1.9",
	"description": "Job listings aggregation and tracking dashboard - Worker package",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WolffM/hadoku-jobplatform.git"
	},
	"files": [
		"dist",
		"migrations"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"dev": "vite build --watch",
		"build": "vite build && tsc -p tsconfig.build.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "node --import ./tests/register.mjs --test \"tests/**/*.test.ts\"",
		"prepare": "git config core.hooksPath .husky 2>/dev/null || true"
	},
	"peerDependencies": {
		"@hono/zod-openapi": ">=1.0.0",
		"@wolffm/worker-utils": ">=1.2.15",
		"hono": ">=4.6.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251230.0",
		"@eslint/js": "^9.39.1",
		"@hono/zod-openapi": "^1.1.5",
		"@types/node": "^26.1.1",
		"@typescript-eslint/eslint-plugin": "^8.46.4",
		"@typescript-eslint/parser": "^8.46.4",
		"@wolffm/worker-utils": "^1.5.4",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"hono": "^4.11.4",
		"husky": "^9.1.7",
		"miniflare": "4.20260730.0",
		"prettier": "^3.6.2",
		"typescript": "^5.6.3",
		"vite": "^7.1.12",
		"vite-plugin-dts": "^4.5.4"
	}
}
