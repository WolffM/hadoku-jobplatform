{
  "manifest_version": 3,
  "name": "hadoku Fill",
  "version": "0.1.0",
  "description": "Fills Greenhouse, Ashby and Lever applications from your hadoku job packet. You review and submit.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://hadoku.me/*",
    "https://job-boards.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.ashbyhq.com/*",
    "https://jobs.lever.co/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.lever.co/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
