# Dependencies
# No trailing slash, deliberately. `node_modules/` matches DIRECTORIES only,
# and .husky/pre-commit symlinks the main checkout's node_modules into a fresh
# worktree so the gates can run there. A symlink is not a directory, so the
# slashed pattern let `git add -A` commit the links themselves.
node_modules

# Build outputs
dist/
build/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

.npmrc

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
# Console/page dumps written into the repo root by the Playwright MCP server.
# Untracked but unignored is the dangerous combination — one `git add -A` and
# browser logs land in a public repo. Nine sibling repos already ignore it.
.playwright-mcp/

# Temporary
.tmp/
.cache/

# Legacy scraper (replaced by hadoku-scrape)
extract/

# per-repo vault key (Phase 2 of per-key ACL plan; never commit)
.devvault.local.json

# vibeCompact audit working artifacts (regenerable; ledger + trends stay tracked)
.vibecompact/audit.md
.vibecompact/out/

# Agent worktrees (AGENTS.md tells every agent to create one here). These are
# full checkouts of this repo, so leaving them untracked-but-not-ignored lets
# filesystem-walking tools treat them as part of it: a local vibeCompact run
# reported 9202 duplicated lines across 44 files, every one of them a file
# "cloned" by its own copy in the worktree. eslint hit the same thing from the
# other direction (see eslint.config.js).
.claude/worktrees/
