#!/bin/sh

# --- worktree preamble ---------------------------------------------------
# git resolves a relative core.hooksPath against the WORKING TREE ROOT, so a
# hook only fires in a linked worktree when the directory holding it is tracked.
# husky's generated .husky/_ is not — its own .gitignore excludes it — so every
# commit made from a worktree ran no hook at all. Silently: no warning, no
# non-zero exit. core.hooksPath now points at .husky itself, which is tracked.
[ "${HUSKY-}" = "0" ] && exit 0

# Not in CI. This hook exists for the developer loop: it bumps versions, runs
# lint/format/stylelint and typechecks before a local commit. CI already does
# every one of those as its own job, and publish.yml has its own version-bump
# fallback that walks to an unpublished version — so nothing here is load
# -bearing there.
#
# It was actively harmful, though. The auto-update workflow's "Commit and push
# if changed" step fired this hook, whose typecheck triggers a `pnpm install`
# with no NODE_AUTH_TOKEN in that step, so it died on
# ERR_PNPM_FETCH_401 fetching a private @wolffm package — a dependency-update
# commit failing on the registry auth of a gate CI had already run.
if [ -n "${CI-}" ] || [ -n "${GITHUB_ACTIONS-}" ]; then
  echo "CI detected — skipping pre-commit hook (CI runs these gates as their own jobs)"
  exit 0
fi

# A fresh worktree is missing everything .gitignore excludes, node_modules
# included. Install this worktree's OWN (pnpm hardlinks from its store, so it
# takes seconds when the store is warm). Never link the main checkout's: through
# those links the workspace packages resolve to the MAIN checkout's source, so a
# branch that changes one is typechecked against the old code, and a
# `pnpm install` run in the worktree writes through them into the main checkout.
# Links an older copy of this preamble left behind are removed first.
common_dir=$(git rev-parse --git-common-dir)
case "$common_dir" in /*) ;; *) common_dir="$PWD/$common_dir" ;; esac
main_checkout=$(dirname "$common_dir")

if [ "$main_checkout" != "$PWD" ]; then
  for nm in $(find . -maxdepth 4 \( -path ./.claude -o -name node_modules -type d \) -prune -o -name node_modules -type l -print); do
    case "$(readlink "$nm")" in
      "$main_checkout"/*) echo "🧹 Removing $nm, a link into the main checkout"; rm "$nm" ;;
    esac
  done
fi
if [ ! -e node_modules ]; then
  echo "📦 No node_modules — installing this checkout's own"
  if ! CI=true pnpm install --frozen-lockfile; then
    echo "❌ pnpm install failed. A private @wolffm package needs NODE_AUTH_TOKEN; install, then commit again."
    exit 1
  fi
fi
# --- end worktree preamble -----------------------------------------------

echo "Running pre-commit checks..."

# Capture originally staged files BEFORE any modifications
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Dangling-install check — MUST run before lint:fix.
#
# When worker/node_modules is left pointing at a deleted worktree's store,
# @cloudflare/workers-types stops resolving and eslint reports thousands of
# no-unsafe-* errors in files nobody touched. Running this first means you get
# the one-line cause instead of that wall of noise.
echo "🔗 Checking node_modules links..."
node scripts/check-node-modules-links.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# Auto-fix linting and formatting issues
echo "Running ESLint auto-fix..."
pnpm run lint:fix
if [ $? -ne 0 ]; then
  echo "ESLint found errors that could not be auto-fixed."
  echo "Please fix the errors manually before committing."
  exit 1
fi

echo "Auto-formatting code..."
pnpm run format

# CSS gate — fails on `var(--x)` references to undeclared custom properties
# (catches typos against @wolffm/themes).
echo "Running stylelint..."
if ! pnpm run lint:css; then
  echo "stylelint found unknown CSS custom properties — check the var name against @wolffm/themes."
  exit 1
fi

echo "Linting and formatting complete!"

# ----------------------------------------------------------------------------
# Version bumping
# ----------------------------------------------------------------------------
# Bump package.json on every commit so publishes always have a unique version.
# Also bump worker/package.json when the commit touches worker/ files —
# without this, worker code changes ship against a stale version and GH
# Packages silently no-ops the publish ("no new packages" in CI output).
#
# Each package is bumped independently (patch+1, rollover at .20 to next
# minor). Versions are NOT kept in sync between root and worker — they each
# track their own release cadence.

bump_version() {
  pkg_path="$1"
  label="$2"

  current=$(node -p "require('./${pkg_path}').version")
  major=$(echo "${current}" | cut -d. -f1)
  minor=$(echo "${current}" | cut -d. -f2)
  patch=$(echo "${current}" | cut -d. -f3)

  if [ "${patch}" -eq 20 ]; then
    new_minor=$((minor + 1))
    new_version="${major}.${new_minor}.0"
    echo "${label}: rolling over to minor version"
  else
    new_patch=$((patch + 1))
    new_version="${major}.${minor}.${new_patch}"
  fi

  node -e "
const fs = require('fs');
const p = '${pkg_path}';
const src = fs.readFileSync(p, 'utf8');
const next = src.replace(/(\"version\"\s*:\s*\")[^\"]*(\")/, (m, a, b) => a + '${new_version}' + b);
if (next === src) { console.error('could not patch version in ' + p); process.exit(1); }
fs.writeFileSync(p, next);
"

  echo "${label} version bumped: ${current} -> ${new_version}"
}

echo "Bumping versions..."

# Always bump the root (UI) package — matches existing behavior
bump_version "package.json" "UI"
git add package.json

# Conditionally bump the worker package when worker/ files are in this commit
if echo "${STAGED_FILES}" | grep -q '^worker/'; then
  bump_version "worker/package.json" "Worker"
  git add worker/package.json
else
  echo "Worker: no worker/ files staged, skipping version bump"
fi

# Update lock file once, after all bumps
pnpm install --lockfile-only
git add pnpm-lock.yaml

# Re-stage files that may have been touched by lint/format
if [ -n "${STAGED_FILES}" ]; then
  echo "${STAGED_FILES}" | xargs -r git add
fi

# TS gate — prevents commits that break tsc (resilience plan track 1)
echo "🔎 Running typecheck..."
if ! pnpm run typecheck; then
  echo '❌ TypeScript errors — fix before committing (or --no-verify to bypass).'
  exit 1
fi

echo "All pre-commit checks passed!"
